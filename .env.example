# ========== Gateway Server Configuration ==========
SERVER_PORT=8400
SPRING_APPLICATION_NAME=api-gateway

# ========== Client CORS Configuration ==========
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== Downstream Services URLs ==========
# Mặc định: chạy gateway trực tiếp trên host (IDE/mvnw) -> dùng localhost.
# Nếu chạy api-gateway bằng Docker (backend-java/backend-py chạy ngoài host hoặc ở compose project khác),
# dùng host.docker.internal thay vì localhost để container reach được host.
JAVA_BACKEND_URI=http://localhost:8401
PYTHON_AI_URI=http://localhost:8402

# ========== JWT Secret Key (Must match backend-java's JWT_SECRET) ==========
JWT_SECRET=Unisage_Enterprise_Assistant_Authentication_Secret_Key

# ========== Internal Secret Key (Must match backend-py's INTERNAL_SECRET_KEY) ==========
INTERNAL_SECRET_KEY=unisage-internal-secret-key-2026
